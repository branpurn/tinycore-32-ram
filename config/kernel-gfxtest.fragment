# QEMU-ONLY test kernel for the graphics stage (`make gfx-kernel`,
# docs/GRAPHICS.md). Never goes on a floppy or the CF card: the 755C BIOS
# has no VBE, so vesafb cannot work there (the 755C uses the tc755 kernel
# + wd90c24fb instead). Applied on top of base hdd tce modules.
CONFIG_LOCALVERSION="-gfxtest"
# CONFIG_LOCALVERSION_AUTO is not set
# vesafb: 640x480x8 packed pseudocolour from SeaVGABIOS (boot with vga=0x301),
# the same /dev/fb0 format wd90c24fb gives Xfbdev on the 755C.
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_VESA=y
# PS/2 mouse (QEMU's i8042 AUX = the 755C TrackPoint path) -> /dev/input/mice
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
# AF_UNIX for X: config/kernel-xnet.fragment (shared with the 755C kernel) is
# applied after this one by scripts/build-gfx-kernel.sh.
