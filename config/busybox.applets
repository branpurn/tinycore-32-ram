# tc32 busybox: applied on top of `make allnoconfig`.  One CONFIG_ name per
# line (set to y).  Lines "NAME=value" set non-boolean values.
# Roughly the subset of Tiny Core's busybox that tc-config / tce-load and an
# interactive text session actually use.
STATIC
BUSYBOX
FEATURE_INSTALLER
LFS
LONG_OPTS
FEATURE_DEVPTS
SHOW_USAGE
FEATURE_COMPRESS_USAGE
FEATURE_HUMAN_READABLE
# --- shell ---
ASH
SH_IS_ASH
BASH_IS_NONE
ASH_OPTIMIZE_FOR_SIZE
ASH_INTERNAL_GLOB
ASH_JOB_CONTROL
ASH_ALIAS
ASH_GETOPTS
ASH_CMDCMD
ASH_ECHO
ASH_PRINTF
ASH_TEST
ASH_EXPAND_PRMT
FEATURE_SH_MATH
FEATURE_EDITING
FEATURE_EDITING_MAX_LEN=512
FEATURE_EDITING_HISTORY=32
FEATURE_TAB_COMPLETION
FEATURE_EDITING_FANCY_PROMPT
# --- init / power ---
INIT
FEATURE_USE_INITTAB
FEATURE_INIT_SCTTY
HALT
POWEROFF
REBOOT
# --- coreutils ---
BASENAME
CAT
CHGRP
CHMOD
CHOWN
CHROOT
CP
FEATURE_CP_LONG_OPTIONS
CUT
DATE
DD
DF
DIRNAME
DU
ECHO
FEATURE_FANCY_ECHO
ENV
EXPR
EXPR_MATH_SUPPORT_64
FALSE
HEAD
FEATURE_FANCY_HEAD
ID
LN
LS
FEATURE_LS_FILETYPES
FEATURE_LS_FOLLOWLINKS
FEATURE_LS_RECURSIVE
FEATURE_LS_WIDTH
FEATURE_LS_SORTFILES
FEATURE_LS_TIMESTAMPS
FEATURE_LS_USERNAME
MKDIR
MKNOD
MKTEMP
MV
PRINTF
PWD
READLINK
RM
RMDIR
SEQ
SLEEP
SORT
STAT
STTY
SYNC
TAIL
FEATURE_FANCY_TAIL
TEE
TEST
TEST1
TEST2
TOUCH
TR
TRUE
UNAME
UNIQ
WC
WHOAMI
YES
# --- text / find ---
AWK
GREP
EGREP
FEATURE_GREP_CONTEXT
SED
FIND
FEATURE_FIND_PRINT0
FEATURE_FIND_MTIME
FEATURE_FIND_TYPE
FEATURE_FIND_PATH
FEATURE_FIND_MAXDEPTH
FEATURE_FIND_EXEC
FEATURE_FIND_NOT
XARGS
LESS
VI
