# Pinned upstream sources. Format: NAME_VER, NAME_URL, NAME_SHA256.
# Sourced by scripts/*.sh. Bump versions here only, and update the sha256.

LINUX_VER=6.18.57
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${LINUX_VER}.tar.xz
LINUX_SHA256=5bd9acdc82ec5efc3790ae840e5aaa40dfde7efff261cf6dde902dc570acf98c

BUSYBOX_VER=1.37.0
BUSYBOX_URL=https://busybox.net/downloads/busybox-${BUSYBOX_VER}.tar.bz2
BUSYBOX_SHA256=3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4

# Prebuilt musl cross toolchain targeting i486 (gcc + musl, static-friendly).
MUSL_TC_URL=https://musl.cc/i486-linux-musl-cross.tgz
MUSL_TC_SHA256=1b7eceb2022f4a664028dd314c5c44332b601bd271e40f0934b4bc8fd3b0fcf5
MUSL_TC_PREFIX=i486-linux-musl-

# Bootloader: syslinux 4.07 (ldlinux.sys ~36 KB, no .c32 modules needed;
# 6.x needs ldlinux.c32 (~120 KB) which wastes floppy space).
SYSLINUX_VER=4.07
SYSLINUX_URL=https://mirrors.edge.kernel.org/pub/linux/utils/boot/syslinux/4.xx/syslinux-${SYSLINUX_VER}.tar.xz
SYSLINUX_SHA256=8e228c34b8a98166a4d42bf0c8ad0ff767ea9ff38dc03b6543248944be6e1887

# Host tools built locally (no root needed) if missing on the host.
M4_VER=1.4.19
