tc32: let a video-memory-shadow fbdev driver mirror screen copies and solid
fills with its blitter (kdrive/fbdev + wd90c24fb, 0004): fbBltHook/fbSolidHook,
only inside operations that do nothing else (fbHookScope).

--- a/fb/fb.h
+++ b/fb/fb.h
@@ -899,6 +899,26 @@
 /*
  * fbblt.c
  */
+
+/*
+ * tc32: hooks for a frame buffer that is a shadow of video memory
+ * (kdrive/fbdev + wd90c24fb). fbBltHook runs before a GXcopy blit with all
+ * planes, fbSolidHook after a solid fill (and == 0); the driver decides
+ * from the pointers whether the frame buffer itself is involved.
+ */
+extern void (*fbBltHook) (FbBits * src, FbStride srcStride, int srcX,
+                          FbBits * dst, FbStride dstStride, int dstX,
+                          int width, int height, int bpp);
+extern void (*fbSolidHook) (FbBits * dst, FbStride dstStride, int dstX,
+                            int bpp, int width, int height, FbBits xor);
+/*
+ * The hooks only run while fbHookScope is set: inside an operation that
+ * does nothing but the copy or the fill (CopyArea and PolyFillRect from
+ * the protocol, CopyWindow, solid window backgrounds and borders). Text,
+ * arcs, wide lines etc. fill and then draw more on top in one operation.
+ */
+extern int fbHookScope;
+
 extern _X_EXPORT void
 
 fbBlt(FbBits * src,
