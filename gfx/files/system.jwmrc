<?xml version="1.0"?>
<!-- tc32 default jwm config (8 bpp: solid colours only, core font "fixed").
     Copy to ~/.jwmrc to change it. Any mouse button on the desktop opens
     the menu; so does the "tc32" button on the taskbar. -->
<JWM>
  <RootMenu onroot="123">
    <Program label="Terminal (rxvt)">rxvt -fn fixed</Program>
    <Program label="Clock (xclock)">xclock</Program>
    <Program label="Calculator (xcalc)">xcalc</Program>
    <Program label="Eyes (xeyes)">xeyes</Program>
    <Separator/>
    <Restart label="Restart jwm"/>
    <Exit label="Exit X" confirm="false"/>
  </RootMenu>
  <Tray x="0" y="-1" height="20" autohide="off">
    <TrayButton label="tc32">root:1</TrayButton>
    <TaskList maxwidth="200"/>
    <Clock format="%H:%M"><Button mask="123">exec:rclock</Button></Clock>
  </Tray>
  <WindowStyle>
    <Font>fixed</Font>
    <Width>3</Width>
    <Height>18</Height>
    <Foreground>#000000</Foreground>
    <Background>#c0c0c0</Background>
    <Outline>#000000</Outline>
    <Opacity>1.0</Opacity>
    <Active>
      <Foreground>#ffffff</Foreground>
      <Background>#000080</Background>
      <Outline>#000000</Outline>
      <Opacity>1.0</Opacity>
    </Active>
  </WindowStyle>
  <TrayStyle>
    <Font>fixed</Font>
    <Background>#c0c0c0</Background>
    <Foreground>#000000</Foreground>
  </TrayStyle>
  <TaskListStyle>
    <Font>fixed</Font>
    <Active><Foreground>#ffffff</Foreground><Background>#000080</Background></Active>
    <Foreground>#000000</Foreground>
    <Background>#c0c0c0</Background>
  </TaskListStyle>
  <MenuStyle>
    <Font>fixed</Font>
    <Foreground>#000000</Foreground>
    <Background>#c0c0c0</Background>
    <Active><Foreground>#ffffff</Foreground><Background>#000080</Background></Active>
    <Opacity>1.0</Opacity>
  </MenuStyle>
  <Desktops width="1" height="1">
    <Background type="solid">#008080</Background>
  </Desktops>
  <FocusModel>click</FocusModel>
  <SnapMode distance="8">border</SnapMode>
  <MoveMode>outline</MoveMode>
  <ResizeMode>outline</ResizeMode>
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <!-- keyboard-only use (no TrackPoint): Alt+F1 menu, Alt+Tab, Alt+F4 -->
  <Key mask="A" key="F1">root:1</Key>
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="F2">window</Key>
  <Key mask="A" key="Return">exec:rxvt -fn fixed</Key>
  <Key key="Up">up</Key>
  <Key key="Down">down</Key>
  <Key key="Right">right</Key>
  <Key key="Left">left</Key>
  <Key key="Return">select</Key>
  <Key key="Escape">escape</Key>
</JWM>
